# =============================================================================
# Senior System — Exemplo de configuração
# =============================================================================
# Este arquivo é versionado e contém APENAS placeholders.
# Copie para `.env` e preencha com seus valores reais:
#     cp .env.example .env
#
# IMPORTANTE:
#   • NUNCA commite o `.env` real
#   • O `.env` já está no `.gitignore`
#   • Rotacione TODOS os segredos aqui se o repositório já foi público
# =============================================================================

# -----------------------------------------------------------------------------
# Banco de Dados MySQL
# -----------------------------------------------------------------------------
MYSQL_DATABASE=senior_system
MYSQL_USER=senior_app
MYSQL_PASSWORD=change_me_in_production
MYSQL_ROOT_PASSWORD=change_me_in_production
DATABASE_URL="mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@db:3306/${MYSQL_DATABASE}"

# -----------------------------------------------------------------------------
# Autenticação JWT
# -----------------------------------------------------------------------------
# OBRIGATÓRIO em produção. O servidor PANICA se estiver vazio em release.
# Gere uma chave forte (>= 64 bytes, base64 ou hex):
#     openssl rand -base64 64
# ou
#     openssl rand -hex 64
#
# Rotacione este segredo periodicamente e em caso de suspeita de vazamento.
JWT_SECRET=change_me_generate_with_openssl_rand_base64_64

# -----------------------------------------------------------------------------
# Servidor
# -----------------------------------------------------------------------------
# Porta em que o servidor Axum escuta. Use 0.0.0.0 para aceitar de todas as
# interfaces (apropriado para container); 127.0.0.1 para dev local.
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# Ambiente: "development" | "production"
# Em development: HTTP é permitido, CORS pode ser *.
# Em production: HTTPS é obrigatório (configurar no proxy reverso).
APP_ENV=development

# Lista separada por vírgula de origens CORS permitidas.
# Em production, NUNCA use "*". Exemplo: https://app.suaempresa.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# -----------------------------------------------------------------------------
# Rate Limit
# -----------------------------------------------------------------------------
# Limite de tentativas de login por IP. Padrão: 5 por minuto.
LOGIN_RATE_LIMIT_PER_MINUTE=5

# -----------------------------------------------------------------------------
# Logs (Tracing)
# -----------------------------------------------------------------------------
# Níveis: trace, debug, info, warn, error
# Exemplo focado:  RUST_LOG=senior_system_server=debug,tower_http=info
RUST_LOG=info
