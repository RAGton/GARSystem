# Configuração do Servidor Senior System

# ===========================================================================
# Banco de Dados MySQL
# ===========================================================================
DATABASE_URL=mysql://senior:seniorpass@localhost:3306/senior_db

# ===========================================================================
# Autenticação JWT
# ===========================================================================
# IMPORTANTE: Gere uma chave secreta forte em produção!
# Use um gerador de senha seguro ou comando: openssl rand -base64 64
JWT_SECRET=sua_chave_secreta_muito_longa_e_forte_aqui_mude_em_producao_123456789

# ===========================================================================
# Logs (Tracing)
# ===========================================================================
# Nível de log: trace, debug, info, warn, error
# Exemplo: RUST_LOG=senior_system=debug,info
RUST_LOG=info
