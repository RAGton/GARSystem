# .env
# Este arquivo contém as variáveis de ambiente para a configuração do banco de dados.
# ATENÇÃO: Adicione este arquivo ao seu .gitignore para não cometer senhas no seu repositório!

# Credenciais do Banco de Dados MySQL
MYSQL_DATABASE=seniorsystem
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=root_strong_password

# String de conexão completa que será usada pelo servidor Rust (backend)
DATABASE_URL="mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@db:3306/${MYSQL_DATABASE}"